<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_18sdp"
    tools:context=".Activity.CardDetailsActivity">

    <TextView
        android:fontFamily="@font/cinzel_decorative_bold"
        android:gravity="center"
        android:textSize="@dimen/_25sdp"
        android:id="@+id/txtCardName"
        android:textStyle="bold"
        android:textColor="@color/black"
        tools:text="Card Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/aaa_1_the_fool"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_250sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                            android:textSize="@dimen/_17ssp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="Arcana : "
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:fontFamily="@font/eb_garamond_variable_font_wght"
                            android:id="@+id/txtArcana"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"
                            tools:text="Minor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                            android:textSize="@dimen/_17ssp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="Suit : "
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:fontFamily="@font/eb_garamond_variable_font_wght"
                            android:id="@+id/txtSuit"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"
                            tools:text="Pentacles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                            android:textSize="@dimen/_17ssp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="Rank : "
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:fontFamily="@font/eb_garamond_variable_font_wght"
                            android:id="@+id/txtRank"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"
                            tools:text="King"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                            android:textSize="@dimen/_17ssp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="Element : "
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:fontFamily="@font/eb_garamond_variable_font_wght"
                            android:id="@+id/txtElement"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"
                            tools:text="Earth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                            android:textSize="@dimen/_17ssp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="Number : "
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:fontFamily="@font/eb_garamond_variable_font_wght"
                            android:id="@+id/txtNumber"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"
                            tools:text="14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Suit Meaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:id="@+id/txtSuitMeaning"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Number or Rank Meaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:id="@+id/txtNumberOrRankMeaning"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Core Upright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtCoreUpright"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Core Reversed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtCoreReversed"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Keywords Upright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtKeywordsUpright"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Keywords Reversed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtKeywordsReversed"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Love Upright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtLoveUpright"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Love Reversed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtLoveReversed"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Career Upright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtCareerUpright"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Career Reversed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtCareerReversed"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Spiritual Upright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtSpiritualUpright"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Spiritual Reversed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtSpiritualReversed"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Summary Upright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtSummaryUpright"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/cormorant_garamond_variable_font_wght"
                    android:textSize="@dimen/_17ssp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Summary Reversed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:fontFamily="@font/eb_garamond_variable_font_wght"
                    android:textSize="@dimen/_14sdp"
                    android:id="@+id/txtSummaryReversed"
                    android:textStyle="bold"
                    tools:text="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
